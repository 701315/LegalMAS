# Database
DATABASE_URL=postgresql+asyncpg://mas:mas_dev_password@localhost:5432/mas_dd

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=mas-artifacts
MINIO_SECURE=false

# Application
ENVIRONMENT=development
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# PII Encryption (generate real key for production!)
PII_ENCRYPTION_KEY=dev-encryption-key-change-in-production

# Classification & Embeddings (для Этапа 6)
EMBEDDINGS_MODEL=intfloat/multilingual-e5-large
CLASSIFICATION_REGISTRY_PATH=playbooks/document_types/registry.yaml

# LLM Providers (для Этапа 8)
OPENAI_API_KEY=sk-...change-me
ANTHROPIC_API_KEY=sk-ant-...change-me
LOCAL_LLM_ENDPOINT=http://localhost:11434  # Ollama или vLLM

# Circuit Breaker settings
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# Testing / Integration
DISABLE_DOWNSTREAM_TASKS=false
