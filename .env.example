# Database
DATABASE_URL=postgresql+asyncpg://mas:mas_dev_password@localhost:5432/mas_dd

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=mas-artifacts
MINIO_SECURE=false

# Application
ENVIRONMENT=development
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# PII Encryption (generate real key for production!)
PII_ENCRYPTION_KEY=dev-encryption-key-change-in-production

# Classification & Embeddings (для Этапа 6)
EMBEDDINGS_MODEL=intfloat/multilingual-e5-large
CLASSIFICATION_REGISTRY_PATH=playbooks/document_types/registry.yaml

# LLM Providers (для Этапа 8)
OPENAI_API_KEY=sk-...change-me
ANTHROPIC_API_KEY=sk-ant-...change-me
LOCAL_LLM_ENDPOINT=http://localhost:11434  # Ollama или vLLM

# Circuit Breaker settings
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# Testing / Integration
DISABLE_DOWNSTREAM_TASKS=false

# PII Sanitization (Stage 5)
# Fernet key (base64). Пустой = dev mode (plaintext mapping)
# Генерация: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# Использовать natasha NER для обнаружения имён
PII_NER_ENABLED=true

# Preserve-типы: НЕ токенизировать (используются в YAML playbooks)
PII_PRESERVE_INN=true
PII_PRESERVE_OGRN=true
PII_PRESERVE_CADASTRAL=true

# Заменять имена на роли сторон договора (SELLER/BUYER) если есть applicable_triggers
PII_PRESERVE_PARTY_ROLES=true

# Писать AuditLog при каждой санитизации
PII_AUDIT_ENABLED=true

# Идемпотентность: пропустить если doc.status == sanitized
PII_SKIP_IF_ALREADY_SANITIZED=true

# --- Stage 6 ---
STRUCTURE_MIN_CLAUSE_COVERAGE=0.60
CLASSIFIER_L1_WEIGHT=0.20
CLASSIFIER_L2_ACCEPT_THRESHOLD=0.85
CLASSIFIER_EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
CLASSIFIER_REGISTRY_PATH=playbooks/document_types

# LLM Provider: "none" | "local" | "openai" | "anthropic"
LLM_PROVIDER=none
LLM_LOCAL_MODEL_PATH=C:/LegalMAS/LLMmodel/model.gguf
LLM_LOCAL_N_CTX=4096
LLM_LOCAL_N_GPU_LAYERS=0
LLM_CLOUD_MODEL=gpt-4o-mini
LLM_CLOUD_API_KEY=


