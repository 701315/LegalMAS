# .env.example

# Database
DATABASE_URL=postgresql+asyncpg://mas:mas_dev_password@localhost:5432/mas_dd

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=mas-artifacts
MINIO_SECURE=false

# Application
ENVIRONMENT=development
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Classification & Embeddings (Stage 6 / shared)
EMBEDDINGS_MODEL=intfloat/multilingual-e5-large
CLASSIFICATION_REGISTRY_PATH=playbooks/document_types/registry.yaml

# LLM Providers (общий для Stage 6/8)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_ENDPOINT=http://localhost:11434  # Ollama или vLLM

# Circuit Breaker settings
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# Testing / Integration
DISABLE_DOWNSTREAM_TASKS=false

# --- PII Sanitization (Stage 5) ---
# Fernet key (base64). Пустой = dev mode (plaintext mapping)
# Генерация:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=
PII_NER_ENABLED=true
PII_PRESERVE_INN=true
PII_PRESERVE_OGRN=true
PII_PRESERVE_CADASTRAL=true
PII_PRESERVE_PARTY_ROLES=true
PII_AUDIT_ENABLED=true
PII_SKIP_IF_ALREADY_SANITIZED=true

# --- Stage 6: Structure & Classifier ---
STRUCTURE_MIN_CLAUSE_COVERAGE=0.60
CLASSIFIER_L1_WEIGHT=0.20
CLASSIFIER_L2_ACCEPT_THRESHOLD=0.85
CLASSIFIER_L3_ACCEPT_THRESHOLD=0.80
CLASSIFIER_VOTING_THRESHOLD=0.75
CLASSIFIER_UNCERTAIN_THRESHOLD=0.50
CLASSIFIER_EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
CLASSIFIER_REGISTRY_PATH=playbooks/document_types

# --- Stage 6/8: LLM Provider (L4) ---
# LLM Provider:
#   "none"     — LLM выключен, rules/embeddings only
#   "openai"   — OpenAI-совместимый HTTP API
#   "ollama"   — локальный сервер Ollama (HTTP API)
#   "llamacpp" — локальная GGUF-модель через llama-cpp-python
LLM_PROVIDER=ollama

# For Ollama
LOCAL_LLM_ENDPOINT=http://localhost:11434

# Only for llamacpp (legacy/alternative provider). Leave empty when using ollama.
LLM_LOCAL_MODEL_PATH=
LLM_LOCAL_N_CTX=4096
LLM_LOCAL_N_GPU_LAYERS=0

LLM_CLOUD_MODEL=gpt-4o-mini
LLM_CLOUD_API_KEY=

# --- Stage 7: Dedup & Relations ---
DEDUP_EXACT_ENABLED=true
RELATIONS_FILENAME_ENABLED=true
RELATIONS_TEXT_ENABLED=true
RELATIONS_FILENAME_SIMILARITY_THRESHOLD=75
RELATIONS_MAX_HOPS=2
RELATIONS_MAX_FAMILY_SIZE=20

# --- Stage 8: Runner / Core Engine ---

# Интеграция со Stage 7
RELATIONS_DEDUP_ENABLED=true
RELATIONS_ENABLED=true

# Runner: retrieval и веса
RUNNER_RETRIEVAL_TOP_K=5
RUNNER_DENSE_WEIGHT=0.6
RUNNER_SPARSE_WEIGHT=0.3
RUNNER_METADATA_WEIGHT=0.1

# Runner: классификационные пороги
CLASSIFICATION_L1_ACCEPT=0.90
CLASSIFICATION_L2_ACCEPT=0.85
CLASSIFICATION_L3_ACCEPT=0.80
CLASSIFICATION_L4_ACCEPT=0.70

# Embeddings для Runner (shared с L3)
RUNNER_EMBEDDINGS_ENABLED=true
RUNNER_EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
RUNNER_EMBEDDINGS_CACHE_DIR=.cache/embeddings

# Playbooks / Prompts
PLAYBOOK_DOCUMENT_TYPES_DIR=playbooks/document_types
PLAYBOOK_DEFAULT_PATH=playbooks/test/v1.0/playbook.yaml
PROMPTS_DIR=prompts

# --- Aggregator & Exporter ---
EXPORT_DD_REQUEST_SOURCE=yaml
EXPORT_STRUCTURED_DATA_ENABLED=true
EXPORT_CONDITIONAL_CHECKS_SHEET=true
EXPORT_CLASSIFICATION_METADATA=true

# Office → PDF Converter (DOC/DOCX)
DOCX_CONVERTER_URL=http://localhost:8080/convert
DOCX_CONVERTER_TIMEOUT_SECONDS=120
