# Пример конфигурации monitoring stack.
# Скопируйте в .env.monitoring и задайте свои значения.
# .env.monitoring в git не коммитим — там реальные секреты.

MONITORING_BIND_ADDRESS=127.0.0.1

PROMETHEUS_PORT=19090
LOKI_PORT=13100
ALERTMANAGER_PORT=19093
TEMPO_PORT=13200
GRAFANA_PORT=13000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
