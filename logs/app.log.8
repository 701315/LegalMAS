\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u2013 \u0433\u043e\u0440\u043e\u0434 \u0424\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u0438, \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434, \u043f\u043e\u043b \u2013 \u043c\u0443\u0436\u0441\u043a\u043e\u0439; \u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0440\u0435\u043a\u0432\u0438\u0437\u0438\u0442\u044b \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430, \u0443\u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u044f\u044e\u0449\u0435\u0433\u043e\\n\\n\u043b\u0438\u0447\u043d'", "body_preview": "'1. \u041f\u0420\u0415\u0414\u041c\u0415\u0422\\n\\n\u041f\u0420\u0415\u0414\u041c\u0415\u0422\\n\\n1.1 \u041f\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u0414\u043e\u0433\u043e\u0432\u043e\u0440\u0443 \u041f\u0440\u0414\u043e\u041e\u0434\u0413\u0430\u041e\u0432\u0412\u0435\u041e\u0446\u0420 \u043e\u0410\u0431\u044f\u0437\u0443\u0435\u0442\u0441\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0442\u044c \u0432 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c\\n\\n\u041f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f, \u043f\u0440\u0438\u043d\u044f\u0442\u044c \u0438 \u0443\u043f\u043b\u0430\u0442\u0438\u0442\u044c \u0430 \u041f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044c \u043f\u043e \u0446\u0435\u043d\u0435 \u0438 \u043d\u0430 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u043e\u0431\u044f\u0437\u0443\u0435\u0442\u0441\u044f \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0433\u043e \u0414\u043e\u0433\u043e\u0432\u043e\u0440\u0430 \u043e\u0431\u044a\u0435\u043a\u0442 \u043d\u0435\u0434\u0432\u0438\u0436\u0438\u043c\u043e\u0433\u043e \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0441\u043e\\n\\n\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c\u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0430\u043c\u0438:\\n\\n\u043a\u0430\u0434\u0430\u0441\u