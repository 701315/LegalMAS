0441\u0442\u0438 \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d 15 \u0434\u0435\u043a\u0430\u0431\u0440\u044f 2014 \u0433\u043e\u0434\u0430 \u043c\u0435\u0436\u0434\u0443:\\n\\n(1) \u041e\u0431\u0449\u0435\u0441\u0442\u0432\u043e\u043c \u0441 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0439 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e \u0413\u0440\u0438\u0444\u0444\u0438\u043d-\u0410\u0432\u0442\u043e\u0441\u0435\u0440\u0432\u0438\u0441 ,\\n\\n\u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442'", "body_preview": "'1.1 \u0410\u043a\u0442 \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u0430\u043a\u0442 \u043f\u0440\u0438\u0435\u043c\u0430-\u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u041e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u043d\u0435\u0434\u0432\u0438\u0436\u0438\u043c\u043e\u0441\u0442\u0438, \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0439 \u043f\u043e\\n\\n\u0444\u043e\u0440\u043c\u0435, \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u0439 \u0432 \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438 1 \u043a \u0414\u043e\u0433\u043e\u0432\u043e\u0440\u0443, \u043f\u043e\u0434\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u043c\u044b\u0439 \u0443\u043f\u043e\u043b\u043d\u043e\u043c\u043e\u0447\u0435\u043d\u043d\u044b\u043c\u0438\\n\\n\u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u044f\u043c\u0438 \u041f\u0440\u043e\u0434\u0430\u0432\u0446\u0430 \u0438 \u041f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f.\\n\\n1.2 \u0410\u043a\u043a\u0440\u0435\u0434\u0438\u0442\u0438\u0432\u044b \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u0430\u043a\u043a\u0440\u0435\u0434\u0438\u0442\u0438\u0432\u044b, \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u043c\u044b\u0435 \u041f\u043e\u043a\u0443\u043f\u0430\u0442\u0